        client.send("Connected to the server".encode(FORMAT))

        # abre uma thread só pra esse cliente, assim o servidor consegue atender vários ao mesmo tempo
        thread = threading.Thread(
            target=handle_client,
            args=(client, addr)
        )

        thread.start()


