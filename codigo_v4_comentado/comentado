from client_manager import broadcast, remove_client


def handle_client(client, addr):
    connected = True

    while connected:
        try:
            # primeiro recebe o "cabeçalho", que diz o tamanho da mensagem que vem
            msg_length = client.recv(HEADER).decode(FORMAT)

            if msg_length:
                msg_length = int(msg_length)
                # agora sim recebe a mensagem completa, do tamanho que o header disse
                msg = client.recv(msg_length).decode(FORMAT)

                if msg == DISCONNECT_MESSAGE:
                    remove_client(client)
                    break

                # manda pra todo mundo que ta conectado
                broadcast(msg.encode(FORMAT))

        except:
            # se der qualquer erro (cliente caiu, conexão quebrou etc) tira ele da lista
            remove_client(client)
            break

    client.close()


